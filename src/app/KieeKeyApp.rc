//----------------------------------------------------------------------------
// KieeKey v1.2.1 RC2 — KieeKeyApp.rc
// Resources for the Win32 tray application: app icon, DPI/comctl32 v6
// manifest, version info. (The settings dialog is built in code in
// main.cpp so layout stays pixel-exact.)
//----------------------------------------------------------------------------
#include <windows.h>
#include "resource.h"

IDI_APPICON     ICON "KieeKeyApp.ico"
IDI_APPICON_OFF ICON "KieeKeyApp-off.ico"

// RT_MANIFEST (24) — DPI awareness + common controls v6 visual styles.
// This line embeds THE application manifest: exactly ONE copy exists in the
// binary. Resource ID 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, the ID the
// Windows loader requires (never renumber it — a different ID silently
// disables DPI awareness + comctl32 v6). MSVC's linker is told /MANIFEST:NO
// in CMakeLists.txt so it does not auto-embed a second copy (without that,
// MSBuild builds fail with CVT1100 "duplicate resource type:MANIFEST,
// name:1" + LNK1123). MinGW/windres never auto-embeds a manifest, so this
// .rc is the single source of truth on every toolchain.
IDR_MANIFEST RT_MANIFEST "KieeKeyApp.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,2,1,0
 PRODUCTVERSION  1,2,1,0
 FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
 FILEFLAGS       0x1L
#else
 FILEFLAGS       0x0L
#endif
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KieeKey"
            VALUE "FileDescription",  "KieeKey — Bộ gõ Tiếng Việt"
            VALUE "FileVersion",      "1.2.1.0"
            VALUE "InternalName",     "KieeKey"
            VALUE "OriginalFilename", "KieeKeyApp.exe"
            VALUE "ProductName",      "KieeKey"
            VALUE "ProductVersion",   "1.2.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
